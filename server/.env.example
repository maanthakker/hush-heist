# Copy to .env for local development. On Render/Railway, add these in the dashboard.
PORT=4000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Leave empty to run
# without a database: the game still works, runs just aren't counted.
MONGODB_URI=
MONGODB_DB=hush-heist

# Where the frontend lives. Comma-separate several, e.g.
# http://localhost:5173,https://hush-heist.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Make it long and random, and keep it private.
# (If you leave it out, everyone gets logged out whenever the server restarts.)
JWT_SECRET=change-me-to-a-long-random-string
